# CONFIGURAÇÃO - TRÊS VOZES PODCAST
# ======================================

# Claude API
ANTHROPIC_API_KEY=sk-seu-token-aqui

# Google Cloud
# Você precisa:
# 1. Criar um projeto em https://console.cloud.google.com
# 2. Ativar Google Cloud Text-to-Speech API
# 3. Criar uma Service Account
# 4. Baixar a chave JSON
# 5. Colocar o caminho aqui

GOOGLE_APPLICATION_CREDENTIALS=./chave-google.json

# Configurações do Podcast
PASTA_TRABALHO=./podcast_tres_vozes
MODELO_CLAUDE=claude-opus-4-6
