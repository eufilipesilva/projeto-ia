app/laboratorios/*.wav

# ── Acervo de histórias (ago/2026) ──────────────────────────────────────────
# Corpus MLS Portuguese baixado (2,4 GB + extração) — refazível com o link
# registrado em acervo/README.md
app/laboratorios/mls_pt/

# Áudio gerado e vozes de referência: todos regeráveis pelos módulos do acervo
# (banco_vozes.py, importar_corpus.py, sintetizar.py). O que precisa versionar
# é a RECEITA, não o wav.
app/estudio/acervo/audios/
app/estudio/acervo/vozes_corpus/
app/estudio/acervo/vozes_personagens/*/
!app/estudio/acervo/vozes_personagens/mapa.json
app/estudio/acervo/_inventario_vozes.json
app/estudio/acervo/_log_*.txt

# Estúdio de Animação (27-28/09/2026)
cache/
# ferramentas de terceiros: clones com pesos de dezenas de GB (reinstalar: ferramentas/terceiros/README.md)
ferramentas/JoyVASA/
ferramentas/MuseTalk/
ferramentas/syncnet/
